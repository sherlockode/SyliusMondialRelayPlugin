<div class="pickup-points-search">
    <div class="pickup-points-search-form">
        <form action=""></form>
        {{ form_start(form, {'attr': {'class': 'search-pickup-point-form'}}) }}
        <div class="row align-items-end pickup-points-input">
            <div class="col-12 col-md-4">
                <div class="search-pickup-point-autocomplete position-relative">
                    {{ form_label(form.zipCode, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.zipCode, {
                        'attr': {
                            'class': 'form-control',
                            'autocomplete': 'off',
                            'data-mr-autocomplete': 'true'
                        }
                    }) }}
                    {{ form_widget(form.suggestion) }}
                    <ul class="list-group position-absolute w-100"></ul>
                </div>
            </div>

            <div class="col-12 col-md-3">
                {{ form_row(form.types) }}
            </div>

            <div class="col-12 col-md-4">
                <div class="btn-group">
                    <button type="button" class="btn btn-primary btn-sm" data-mr-geolocation title="{{ 'sylius.mondial_relay.geolocation'|trans }}">
                        {{ 'sylius.mondial_relay.geolocation'|trans }}
                    </button>

                    <button type="submit" class="btn btn-primary btn-sm" title="{{ 'sylius.mondial_relay.search'|trans }}">
                        {{ 'sylius.mondial_relay.search'|trans }}
                    </button>

                </div>
            </div>
        </div>

        {{ form_end(form) }}
    </div>

    {# Carte #}
    <div class="pickup-points-map mt-4" id="pickup-points-map"></div>

    {# Résultats #}
    <div class="pickup-points-search-results mt-4">
        <div class="pickup-points-no-results alert alert-warning d-none">
            {{ 'sylius.mondial_relay.no_result_for_your_search'|trans }}
        </div>

        <div class="pickup-points-results-list"></div>
        <ul class="pickup-points-pagination pagination mt-3"></ul>
    </div>
</div>
